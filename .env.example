# Provider priority: XAI_API_KEY > GROQ_API_KEY > OPENAI_API_KEY > PROVIDER=ollama
# If none are set, defaults to local Ollama automatically.

# Local Ollama (no API key needed — runs on your machine)
PROVIDER=ollama
MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434/v1   # override if Ollama runs elsewhere

# xAI / Grok
# XAI_API_KEY=your_xai_api_key_here
# MODEL=grok-3-mini

# Groq (free tier, very fast)
# GROQ_API_KEY=your_groq_api_key_here
# MODEL=llama-3.3-70b-versatile

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL=gpt-4.1-mini

PORT=8787
